{
  "name": "pos-backend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "ফার্মেসি ও কসমেটিক্স দোকানের POS — ব্যাকএন্ড API (TypeScript, Supabase PostgreSQL + Edge Functions)",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "build:edge": "node edge/build.mjs",
    "db:migrate": "tsx scripts/db-migrate.ts"
  },
  "dependencies": {
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
