# এই ফাইলটি .env নামে কপি করে মান বসান। .env কখনো GitHub এ তুলবেন না।

# --- Supabase PostgreSQL (Dashboard -> উপরের Connect বোতাম) ---
# DATABASE_URL: API যেটা ব্যবহার করে — "Transaction pooler" (পোর্ট 6543)।
#   ইউজারনেম অবশ্যই  pos_app.<PROJECT_REF>  (postgres.<ref> নয়! `postgres` রোল RLS এড়িয়ে যায়)।
DATABASE_URL=postgresql://pos_app.PROJECT_REF:POS_APP_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# DATABASE_URL_UNPOOLED: শুধু মাইগ্রেশনের জন্য — "Session pooler" (পোর্ট 5432), ইউজার  postgres.<PROJECT_REF>।
# (Direct connection ফ্রি প্ল্যানে IPv6-only, তাই Session pooler ব্যবহার করুন।)
DATABASE_URL_UNPOOLED=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# pos_app রোলের পাসওয়ার্ড (নিজে বানান, কমপক্ষে ১৬ অক্ষর, শুধু অক্ষর/অঙ্ক রাখলে URL এ সমস্যা হয় না)।
# `npm run db:migrate` এটি ডাটাবেসে বসিয়ে দেয়। উপরের DATABASE_URL এ একই পাসওয়ার্ড দিন।
POS_APP_PASSWORD=

# --- API ---
# লগইন টোকেন সই করার গোপন কী — কমপক্ষে ৩২ র‍্যান্ডম অক্ষর। কোথাও পুনর্ব্যবহার করবেন না।
# বানাতে: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# টোকেনের মেয়াদ (সেকেন্ড)। ডিফল্ট ১২ ঘণ্টা।
# TOKEN_TTL_SECONDS=43200

# যেসব ওয়েবসাইট ব্রাউজার থেকে API ডাকতে পারবে (কমা দিয়ে, পুরো ঠিকানা, wildcard নয়)।
# ফ্রন্টএন্ড ডিপ্লয় হলে তার ঠিকানা এখানে দিন। লোকালে: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# লোকাল Node সার্ভারের পোর্ট (`npm run dev`)
API_PORT=3001

# development | test | production
# Supabase Edge secrets এ production দিন (deploy-supabase.bat নিজে দেয়)।
NODE_ENV=development
