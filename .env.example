# অ্যাপ যে ডাটাবেস ইউজার দিয়ে চলবে (RLS প্রযোজ্য হবে; টেবিলের মালিক নয়)
DATABASE_URL=postgres://pos_app:change-me@localhost:5432/pos

# শুধু মাইগ্রেশনের জন্য (টেবিলের মালিক ইউজার)। না দিলে DATABASE_URL ব্যবহার হবে।
MIGRATE_DATABASE_URL=postgres://pos_owner:change-me@localhost:5432/pos

# কমপক্ষে ৩২ অক্ষরের র‍্যান্ডম স্ট্রিং, যেমন: openssl rand -base64 48
JWT_SECRET=

PORT=3000

# ফ্রন্টএন্ডের ঠিকানা, কমা দিয়ে একাধিক দেওয়া যায়
CORS_ORIGIN=http://localhost:3001

# লগইন টোকেনের মেয়াদ (সেকেন্ড); ডিফল্ট ১২ ঘণ্টা
TOKEN_TTL_SECONDS=43200
