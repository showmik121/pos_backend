      "input": { "lines": [{ "unitPrice": 333, "qty": 1, "discount": 0 }], "bill": { "type": "percent", "value": 5000 } },
      "output": { "subtotal": 333, "lineDiscount": 0, "billDiscount": 167, "total": 166 }
