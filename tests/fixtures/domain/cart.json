    {
      "name": "একাধিক লাইন",
      "input": {
        "lines": [
          { "unitPrice": 1500, "qty": 4, "discount": 0 },
          { "unitPrice": 2550, "qty": 2, "discount": 100 }
        ],
        "bill": { "type": "amount", "value": 0 }
      },
      "output": { "subtotal": 11100, "lineDiscount": 100, "billDiscount": 0, "total": 11000 }
    },
    {
      "name": "লাইন ছাড় দামের চেয়ে বেশি",
      "input": { "lines": [{ "unitPrice": 1000, "qty": 1, "discount": 1001 }], "bill": { "type": "amount", "value": 0 } },
      "error": { "code": "discount_too_large" }
    },
    {
      "name": "বিল ছাড় মোটের চেয়ে বেশি",
      "input": { "lines": [{ "unitPrice": 1000, "qty": 1, "discount": 0 }], "bill": { "type": "amount", "value": 1001 } },
      "error": { "code": "discount_too_large" }
    },
    {
      "name": "১০০% এর বেশি",
