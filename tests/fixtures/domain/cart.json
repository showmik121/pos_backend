{
  "fn": "computeCart",
  "note": "টাকা পয়সায়। percent = শতাংশ × ১০০, Math.round(base × percent / ১০০০০)",
  "cases": [
    {
      "name": "সাধারণ বিল",
      "input": { "lines": [{ "unitPrice": 10000, "qty": 2, "discount": 0 }], "bill": { "type": "amount", "value": 0 } },
      "output": { "subtotal": 20000, "lineDiscount": 0, "billDiscount": 0, "total": 20000 }
    },
    {
      "name": "লাইন ছাড়",
      "input": { "lines": [{ "unitPrice": 5000, "qty": 3, "discount": 1000 }], "bill": { "type": "amount", "value": 0 } },
      "output": { "subtotal": 15000, "lineDiscount": 1000, "billDiscount": 0, "total": 14000 }
    },
    {
      "name": "বিলে টাকার ছাড়",
      "input": { "lines": [{ "unitPrice": 10000, "qty": 1, "discount": 0 }], "bill": { "type": "amount", "value": 2500 } },
      "output": { "subtotal": 10000, "lineDiscount": 0, "billDiscount": 2500, "total": 7500 }
    },
    {
      "name": "শতাংশ ছাড় ৭.৫%",
